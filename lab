#!/usr/bin/env bash
set -euo pipefail
umask 077

LAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$LAB_ROOT/lib/common.sh"
source "$LAB_ROOT/lib/pve-api.sh"
source "$LAB_ROOT/lib/cloudflare.sh"
source "$LAB_ROOT/lib/hosts-layer.sh"
source "$LAB_ROOT/lib/host-layer.sh"
source "$LAB_ROOT/lib/seats-layer.sh"
source "$LAB_ROOT/lib/rehearsal-layer.sh"
source "$LAB_ROOT/lib/site-layer.sh"
source "$LAB_ROOT/lib/failover-layer.sh"
source "$LAB_ROOT/lib/upgrade-layer.sh"
source "$LAB_ROOT/lib/access-layer.sh"
source "$LAB_ROOT/lib/install-layer.sh"
source "$LAB_ROOT/lib/local-layer.sh"
source "$LAB_ROOT/lib/campus-layer.sh"

usage() {
  cat >&2 <<'EOF'
usage: lab hosts
       lab hosts add <host> <index> <seats>
       lab hosts seats <host> <seats>
       lab hosts remove <host>
       lab access up|serve|target|down <host>
       lab access verify <host> [host-key-fingerprint]
       lab access ssh <host> [command...]
       lab campus <host> [ssh|proxmox open|close]
       lab campus <host> close|reset
       lab local up|stop|down <host>
       lab host install <host>
       lab host up|verify|hide|show|down [host]
       lab seats create <count>|delete
       lab seat <number> up|upgrade|reset|delete
       lab seat <number> failover [worker-a|worker-b]
EOF
  exit 2
}

main() {
  (($# >= 1)) || usage
  case "$1" in
    hosts)
      case "$#:${2:-}" in
        1:) hosts_list ;;
        5:add)
          lab_lock "$*"
          hosts_add "$3" "$4" "$5"
          ;;
        4:seats)
          lab_lock "$*"
          hosts_set_seats "$3" "$4"
          ;;
        3:remove)
          lab_lock "$*"
          hosts_remove "$3"
          ;;
        *) usage ;;
      esac
      ;;
    access)
      (($# >= 3)) || usage
      case "$2" in
        up | target | down)
          (($# == 3)) || usage
          lab_lock "$*"
          "access_$2" "$3"
          ;;
        verify)
          (($# <= 4)) || usage
          lab_lock "$*"
          access_verify "$3" "${4:-}"
          ;;
        serve)
          (($# == 3)) || usage
          access_serve "$3"
          ;;
        ssh)
          shift 2
          access_ssh "$@"
          ;;
        *) usage ;;
      esac
      ;;
    campus)
      (($# >= 2)) || usage
      lab_lock "$*"
      case "$#:${3:-}" in
        2:) campus_status "$2" ;;
        3:close) campus_close "$2" ;;
        3:reset) campus_reset "$2" ;;
        4:*) campus_set "$2" "$3" "$4" ;;
        *) usage ;;
      esac
      ;;
    local)
      (($# == 3)) || usage
      lab_lock "$*"
      case "$2" in
        up) local_up "$3" ;;
        stop) local_stop "$3" ;;
        down) local_down "$3" ;;
        *) usage ;;
      esac
      ;;
    host)
      (($# == 2 || $# == 3)) || usage
      lab_lock "$*"
      case "$2" in
        install)
          (($# == 3)) || usage
          host_install "$3"
          ;;
        up) host_up "${3:-}" ;;
        verify) host_verify_hosts "${3:-}" ;;
        hide) host_hide "${3:-}" ;;
        show) host_show "${3:-}" ;;
        down) host_down "${3:-}" ;;
        *) usage ;;
      esac
      ;;
    seats)
      (($# >= 2)) || usage
      lab_lock "$*"
      case "$2" in
        create)
          (($# == 3)) || usage
          seats_create "$3"
          ;;
        delete)
          (($# == 2)) || usage
          seats_delete
          ;;
        *) usage ;;
      esac
      ;;
    seat)
      (($# >= 3)) || usage
      lab_lock "$*"
      case "$3" in
        up)
          (($# == 3)) || usage
          seat_up "$2"
          ;;
        upgrade)
          (($# == 3)) || usage
          seat_upgrade "$2"
          ;;
        reset)
          (($# == 3)) || usage
          seat_reset "$2"
          ;;
        delete)
          (($# == 3)) || usage
          seat_remove "$2"
          ;;
        failover)
          (($# <= 4)) || usage
          failover_run "$2" "${4:-worker-b}"
          ;;
        *) usage ;;
      esac
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
