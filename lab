#!/usr/bin/env bash
set -euo pipefail
umask 077

LAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$LAB_ROOT/lib/common.sh"
source "$LAB_ROOT/lib/pve-api.sh"
source "$LAB_ROOT/lib/cloudflare.sh"
source "$LAB_ROOT/lib/proxmox-layer.sh"
source "$LAB_ROOT/lib/host-layer.sh"
source "$LAB_ROOT/lib/seats-layer.sh"
source "$LAB_ROOT/lib/rehearsal-layer.sh"
source "$LAB_ROOT/lib/site-layer.sh"
source "$LAB_ROOT/lib/failover-layer.sh"
source "$LAB_ROOT/lib/upgrade-layer.sh"
source "$LAB_ROOT/lib/access-layer.sh"

usage() {
  cat >&2 <<'EOF'
usage: lab access up|serve|target|down
       lab access verify [host-key-fingerprint]
       lab access ssh [command...]
       lab proxmox up|verify|down
       lab host up|verify|down
       lab seats create <count>|delete
       lab seat <number> up|upgrade|reset|delete
       lab seat <number> failover [worker-a|worker-b]
EOF
  exit 2
}

main() {
  (($# >= 2)) || usage
  case "$1" in
    access)
      case "$2" in
        up)
          (($# == 2)) || usage
          lab_lock "$*"
          access_up
          ;;
        verify)
          (($# <= 3)) || usage
          lab_lock "$*"
          access_verify "${3:-}"
          ;;
        ssh)
          shift 2
          access_ssh "$@"
          ;;
        serve)
          (($# == 2)) || usage
          access_serve
          ;;
        target)
          (($# == 2)) || usage
          lab_lock "$*"
          access_target
          ;;
        down)
          (($# == 2)) || usage
          lab_lock "$*"
          access_down
          ;;
        *) usage ;;
      esac
      ;;
    proxmox)
      (($# == 2)) || usage
      lab_lock "$*"
      case "$2" in
        up) proxmox_up ;;
        verify) proxmox_verify ;;
        down) proxmox_down ;;
        *) usage ;;
      esac
      ;;
    host)
      (($# == 2)) || usage
      lab_lock "$*"
      case "$2" in
        up) host_up ;;
        verify)
          host_load_config
          host_verify
          ;;
        down) host_down ;;
        *) usage ;;
      esac
      ;;
    seats)
      lab_lock "$*"
      case "$2" in
        create)
          (($# == 3)) || usage
          seats_create "$3"
          ;;
        delete)
          (($# == 2)) || usage
          seats_delete
          ;;
        *) usage ;;
      esac
      ;;
    seat)
      (($# >= 3)) || usage
      lab_lock "$*"
      case "$3" in
        up)
          (($# == 3)) || usage
          seat_up "$2"
          ;;
        upgrade)
          (($# == 3)) || usage
          seat_upgrade "$2"
          ;;
        reset)
          (($# == 3)) || usage
          seat_reset "$2"
          ;;
        delete)
          (($# == 3)) || usage
          seat_remove "$2"
          ;;
        failover)
          (($# <= 4)) || usage
          failover_run "$2" "${4:-worker-b}"
          ;;
        *) usage ;;
      esac
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
